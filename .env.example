# Copy to .env for local development. Never commit .env.

# Local Postgres from dev_db/docker-compose.yml (`docker compose -f dev_db/docker-compose.yml up -d`).
DATABASE_URL=postgresql://seobasics:seobasics@localhost:5347/seobasics_dev

# Public base URL of this environment: http://localhost:3000 locally,
# https://dev.seobasics.app (Stripe test mode, dev database) or
# https://seobasics.app (live mode, production database) when deployed.
APP_URL=http://localhost:3000

# Purchase links (runtime). Unset = both point at /#pricing.
# CHECKOUT_URL=
# APP_STORE_URL=

# Set at image build time; /_dev/version reports it.
# SEOBASICS_COMMIT_SHA=

# License token signing (docs/license-api-v1.md). One Ed25519 key per
# environment, from that environment's 1Password item; never commit one.
# Without them the license API answers 503 not_configured.
# LICENSE_SIGNING_KEY=-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----
# LICENSE_SIGNING_KID=dev1
# Optional, after a key rotation: {"<old kid>": "<PEM public key>"}
# LICENSE_PREVIOUS_PUBLIC_KEYS=

# Integration tests only: a dedicated, migrated database that the suite empties.
# TEST_DATABASE_URL=postgresql://seobasics:seobasics@localhost:5347/seobasics_test
